{
  "name": "@skycanvasstudio/sso",
  "version": "0.7.1",
  "description": "Clerk-style embedded and hosted authentication for SkyCanvas SSO, with optional Better Auth integration",
  "homepage": "https://sso.skycanvasstudio.com/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalids01/sso.git",
    "directory": "npm_package"
  },
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Khalid",
    "email": "khalidcode03@gmail.com",
    "url": "https://github.com/khalids01"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": ["dist/server/index.d.ts"],
      "client": ["dist/client/index.d.ts"],
      "react": ["dist/react/index.d.ts"],
      "better-auth": ["dist/better-auth/index.d.ts"],
      "tanstack-start": ["dist/tanstack-start/index.d.ts"],
      "next": ["dist/next/index.d.ts"],
      "node": ["dist/node/index.d.ts"],
      "types": ["dist/types/index.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./dist/react/styles.css",
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "import": "./dist/better-auth/index.js",
      "default": "./dist/better-auth/index.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start/index.d.ts",
      "import": "./dist/tanstack-start/index.js",
      "default": "./dist/tanstack-start/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "pack:check": "npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "bun run check-types && bun test && bun run build && bun run verify:package",
    "publish:public": "npm publish --access public",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.160.0",
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-auth": "1.6.23",
    "@tanstack/react-start": "^1.168.28",
    "next": "^16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sso",
    "oauth2",
    "openid-connect",
    "oidc",
    "pkce",
    "react",
    "embedded-auth",
    "passwordless",
    "tanstack-start",
    "skycanvas"
  ]
}
