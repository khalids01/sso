{
  "name": "@skycanvasstudio/sso",
  "version": "0.1.0",
  "description": "Headless SkyCanvas SSO helpers for servers, browsers, and React",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Khalid",
    "email": "khalidcode03@gmail.com",
    "url": "https://github.com/khalids01"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "pack:check": "npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "bun run check-types && bun test && bun run build && bun run verify:package",
    "publish:public": "npm publish --access public",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "better-auth": "1.6.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sso",
    "oauth2",
    "openid-connect",
    "oidc",
    "pkce",
    "react",
    "skycanvas"
  ]
}
