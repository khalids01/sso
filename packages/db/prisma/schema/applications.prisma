enum ApplicationStatus {
  active
  disabled
  archived
}

enum ApplicationMemberStatus {
  active
  suspended
  revoked
}

enum ApplicationRegistrationMode {
  closed
  invite_only
  open
}

enum OAuthProvider {
  google
  github
  facebook
  linkedin
}

enum OAuthProviderConnectionStatus {
  active
  disabled
  archived
}

enum EmailProvider {
  resend
  nodemailer
}

enum EmailProviderConnectionStatus {
  active
  disabled
  archived
}

enum ApplicationEmailConnectionRole {
  primary
  fallback
}

model Application {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  status           ApplicationStatus @default(active)
  logoUrl          String?
  homepageUrl      String?
  signInMethods    String[] @default(["magic_link", "password"])
  signUpMethods    String[] @default(["magic_link", "password"])
  registrationMode ApplicationRegistrationMode @default(closed)
  passwordEmailVerificationRequired Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clients              ApplicationClient[]
  members              ApplicationMember[]
  subjects             ApplicationSubject[]
  revocationEndpoint   ApplicationRevocationEndpoint?
  revocationDeliveries ApplicationRevocationDelivery[]
  invitations          ApplicationInvitation[]
  oauthProviderConnections ApplicationOAuthProviderConnection[]
  emailProviderConnections ApplicationEmailProviderConnection[]
  emailDeliveryAttempts EmailDeliveryAttempt[]
  usageEvents          ApplicationUsageEvent[]

  @@index([status, createdAt])
  @@map("application")
}

model EmailProviderConnection {
  id                String   @id @default(cuid())
  name              String   @unique
  provider          EmailProvider
  fromName          String
  fromAddress       String
  replyToAddress    String?
  encryptedSecret   String
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean?
  smtpUsername      String?
  credentialVersion Int      @default(1)
  status            EmailProviderConnectionStatus @default(active)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applicationAssignments ApplicationEmailProviderConnection[]
  deliveryAttempts       EmailDeliveryAttempt[]

  @@index([provider, status])
  @@index([status, createdAt])
  @@map("email_provider_connection")
}

model ApplicationEmailProviderConnection {
  applicationId            String
  role                     ApplicationEmailConnectionRole
  emailProviderConnectionId String

  application             Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  emailProviderConnection EmailProviderConnection @relation(fields: [emailProviderConnectionId], references: [id], onDelete: Restrict)

  @@id([applicationId, role])
  @@index([emailProviderConnectionId])
  @@map("application_email_provider_connection")
}

model EmailDeliveryAttempt {
  id                        String   @id @default(cuid())
  applicationId             String?
  emailProviderConnectionId String?
  provider                  EmailProvider?
  outcome                   String
  fallbackUsed              Boolean  @default(false)
  errorCode                 String?
  createdAt                 DateTime @default(now())

  application             Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emailProviderConnection EmailProviderConnection? @relation(fields: [emailProviderConnectionId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([emailProviderConnectionId, createdAt])
  @@map("email_delivery_attempt")
}

model ApplicationInvitation {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email         String
  status        String      @default("pending")
  expiresAt     DateTime
  inviterId     String?
  inviter       User?       @relation("ApplicationInvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, email, status])
  @@index([expiresAt])
  @@index([inviterId])
  @@map("application_invitation")
}

model ApplicationMember {
  id                   String      @id @default(cuid())
  applicationId        String
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               ApplicationMemberStatus @default(active)
  authorizationVersion Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  revocationDeliveries ApplicationRevocationDelivery[]

  @@unique([applicationId, userId])
  @@index([userId])
  @@index([applicationId, status, createdAt])
  @@map("application_member")
}

model ApplicationRevocationEndpoint {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  url           String
  enabled       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  deliveries ApplicationRevocationDelivery[]

  @@map("application_revocation_endpoint")
}

model ApplicationRevocationDelivery {
  id                   String                         @id @default(cuid())
  applicationId        String
  application          Application                    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  endpointId           String?
  endpoint             ApplicationRevocationEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  membershipId         String?
  membership           ApplicationMember?             @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  destinationUrl       String
  eventType            String                         @default("application.access.revoked")
  reason               String
  subject              String?
  authorizationVersion Int?
  effectiveAt          DateTime
  status               String                         @default("pending")
  attemptCount         Int                            @default(0)
  nextAttemptAt        DateTime                       @default(now())
  leaseUntil           DateTime?
  deadlineAt           DateTime
  deliveredAt          DateTime?
  lastHttpStatus       Int?
  lastErrorCode        String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([applicationId, createdAt])
  @@index([endpointId])
  @@index([membershipId])
  @@map("application_revocation_delivery")
}

model ApplicationSubject {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String      @unique
  createdAt     DateTime    @default(now())

  @@unique([applicationId, userId])
  @@index([userId])
  @@map("application_subject")
}

model ApplicationClient {
  id                      String      @id @default(cuid())
  applicationId           String
  application             Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientId                String      @unique
  name                    String
  clientType              String      @default("public")
  status                  ApplicationStatus @default(active)
  oauthDisabled           Boolean     @default(false)
  skipConsent             Boolean     @default(true)
  enableEndSession        Boolean     @default(false)
  scopes                  String[]    @default(["openid"])
  tokenEndpointAuthMethod String      @default("none")
  grantTypes              String[]    @default(["authorization_code"])
  responseTypes           String[]    @default(["code"])
  public                  Boolean     @default(true)
  metadata                Json?
  redirectUris            String[]
  allowedOrigins          String[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  oauthConsents OAuthConsent[]
  usageEvents   ApplicationUsageEvent[]

  @@index([applicationId, status, createdAt])
  @@map("application_client")
}

model OAuthProviderConnection {
  id                String   @id @default(cuid())
  name              String
  provider          OAuthProvider
  clientId          String
  encryptedSecret   String
  credentialVersion Int      @default(1)
  status            OAuthProviderConnectionStatus @default(active)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applicationAssignments ApplicationOAuthProviderConnection[]
  accounts               Account[]
  usageEvents            ApplicationUsageEvent[]

  @@unique([provider, name])
  @@unique([provider, clientId])
  @@unique([id, provider])
  @@index([provider, status])
  @@index([status, createdAt])
  @@map("oauth_provider_connection")
}

model ApplicationOAuthProviderConnection {
  applicationId             String
  provider                  OAuthProvider
  oauthProviderConnectionId String

  application             Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oauthProviderConnection OAuthProviderConnection @relation(fields: [oauthProviderConnectionId, provider], references: [id, provider], onDelete: Restrict)

  @@id([applicationId, provider])
  @@index([oauthProviderConnectionId])
  @@map("application_oauth_provider_connection")
}

model OAuthConsent {
  id          String            @id @default(cuid())
  clientId    String
  client      ApplicationClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}
